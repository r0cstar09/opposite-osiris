---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="cyber-grid" aria-hidden="true"></div>
		<div class="scan-beam" aria-hidden="true"></div>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			.backgrounds {
				position: relative;
				z-index: 0;
				min-height: 100%;
			}

			/* Animated perspective-free neon grid, fixed behind all content. */
			.cyber-grid {
				position: fixed;
				inset: -2px;
				z-index: -2;
				pointer-events: none;
				background-image:
					linear-gradient(var(--grid-color) 1px, transparent 1px),
					linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
				background-size:
					46px 46px,
					46px 46px;
				-webkit-mask-image: radial-gradient(
					ellipse 110% 80% at 50% 24%,
					#000 38%,
					transparent 92%
				);
				mask-image: radial-gradient(ellipse 110% 80% at 50% 24%, #000 38%, transparent 92%);
				animation: gridPan 26s linear infinite;
			}

			/* Occasional horizontal scan sweep across the viewport. */
			.scan-beam {
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				overflow: hidden;
			}

			.scan-beam::after {
				content: '';
				position: absolute;
				left: 0;
				right: 0;
				height: 2px;
				top: -4%;
				background: linear-gradient(
					90deg,
					transparent,
					color-mix(in srgb, var(--accent-regular) 70%, transparent),
					transparent
				);
				box-shadow: 0 0 24px color-mix(in srgb, var(--accent-regular) 55%, transparent);
				animation: scanBeam 9s ease-in-out infinite;
				opacity: 0.55;
			}

			@media (forced-colors: active) {
				.cyber-grid {
					display: none;
				}

				.scan-beam {
					display: none;
				}
			}
		</style>
	</body>
</html>
