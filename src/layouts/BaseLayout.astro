---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="stack page-shell">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));

			const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Cursor-tracking glow on .glow-card panels.
			document.addEventListener('pointermove', (e) => {
				const target = e.target as Element | null;
				const card = target?.closest?.('.glow-card') as HTMLElement | null;
				if (!card) return;
				const r = card.getBoundingClientRect();
				card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
				card.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
			});

			// Staggered scroll reveal. Arm only when JS + motion are available
			// so content is never hidden for no-JS or reduced-motion visitors.
			if (motionOK && 'IntersectionObserver' in window) {
				document.documentElement.classList.add('js');
				const revealables = [...document.querySelectorAll('[data-reveal]')];
				const io = new IntersectionObserver(
					(entries) => {
						let batch = 0;
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							const el = entry.target as HTMLElement;
							el.style.setProperty('--reveal-delay', `${Math.min(batch++ * 90, 450)}ms`);
							el.classList.add('revealed');
							io.unobserve(el);
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
				);
				revealables.forEach((el) => io.observe(el));
			}

			// One-shot decrypt effect for [data-scramble] headings.
			if (motionOK) {
				const el = document.querySelector('[data-scramble]');
				if (el) {
					const final = el.textContent ?? '';
					const glyphs = '█▓▒░<>/\\|=+*#$&ABCDEF0123456789';
					const steps = 22;
					let frame = 0;
					const tick = () => {
						frame++;
						const settled = Math.floor((frame / steps) * final.length);
						el.textContent =
							final.slice(0, settled) +
							[...final.slice(settled)]
								.map((c) => (c === ' ' ? ' ' : glyphs[(Math.random() * glyphs.length) | 0]))
								.join('');
						if (settled < final.length) setTimeout(tick, 34);
						else el.textContent = final;
					};
					tick();
				}
			}
		</script>

		<style>
			.page-shell {
				position: relative;
				z-index: 0;
				min-height: 100vh;
			}
		</style>
	</body>
</html>
