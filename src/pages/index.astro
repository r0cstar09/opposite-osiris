---
import { getCollection } from 'astro:content';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BlogPostPreview from '../components/BlogPostPreview.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: List four most recent work projects and latest blog posts
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-30">
		<div class="wrapper stack gap-15">
			<header class="hero">
				<div class="intro stack gap-4">
					<p class="status-chip">
						<span class="dot" aria-hidden="true"></span>
						status: open_to_new_opportunities
					</p>
					<h1 class="headline">Tony Muzo</h1>
					<p class="tagline">
						I build security automation, threat intelligence reports, and cloud defense tooling —
						turning attacker behavior into actionable defense.
					</p>
					<div class="roles">
						<Pill><Icon icon="shield" size="1.1em" /> Security Engineer</Pill>
						<Pill><Icon icon="code" size="1.1em" /> Automation Builder</Pill>
						<Pill><Icon icon="book-open" size="1.1em" /> Threat Intel Writer</Pill>
					</div>
					<div class="cta-row">
						<a class="btn primary" href="/blog/">
							Read my writing
							<Icon icon="arrow-right" size="1.1em" />
						</a>
						<a class="btn secondary" href="/work/">View work</a>
					</div>
				</div>

				<div class="profile-card">
					<div class="pc-hud" aria-hidden="true">
						<span>// operator_profile</span>
						<span class="pc-online"><i class="pc-dot"></i>online</span>
					</div>
					<div class="pc-head">
						<span class="pc-avatar" aria-hidden="true">TM</span>
						<div class="pc-name">
							<strong>Tony Muzo</strong>
							<span>Cybersecurity Analyst · Toronto, CA</span>
						</div>
					</div>
					<dl class="pc-facts">
						<div>
							<dt>Experience</dt>
							<dd>8+ years across SOC, IR & threat intelligence</dd>
						</div>
						<div>
							<dt>Certifications</dt>
							<dd>GIAC GSEC · GCIH · GPYC · GFACT</dd>
						</div>
						<div>
							<dt>Background</dt>
							<dd>Cisco Security, Symantec, public sector</dd>
						</div>
						<div>
							<dt>Focus</dt>
							<dd>Ransomware ecosystems & MITRE ATT&CK mapping</dd>
						</div>
					</dl>
					<a class="pc-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
				</div>
			</header>

			<Skills />
		</div>

		<main class="stack gap-20 lg:gap-30">
			<section class="wrapper section">
				<header class="section-header">
					<div class="stack gap-2">
						<p class="hud-label">// case_files</p>
						<h2>Selected Work</h2>
						<p>Security engineering, automation, and threat intelligence projects.</p>
					</div>
					<a class="view-all" href="/work/">View all <span aria-hidden="true">→</span></a>
				</header>

				<Grid>
					{
						projects.map((project) => (
							<li>
								<PortfolioPreview project={project} />
							</li>
						))
					}
				</Grid>
			</section>

			<section class="wrapper section">
				<header class="section-header">
					<div class="stack gap-2">
						<p class="hud-label">// threat_intel_feed</p>
						<h2>Latest Writing</h2>
						<p>Practitioner analysis of the threats and incidents that matter this week.</p>
					</div>
					<a class="view-all" href="/blog/">All articles <span aria-hidden="true">→</span></a>
				</header>

				<div class="blog-preview-list">
					{posts.map((post) => <BlogPostPreview post={post} />)}
				</div>
			</section>

			<section class="wrapper section">
				<header class="section-header">
					<div class="stack gap-2">
						<p class="hud-label">// stack</p>
						<h2>Platforms & Training</h2>
						<p>Tooling and standards I work across every day.</p>
					</div>
				</header>

				<ul class="brand-row">
					{
						['GitHub', 'SANS Institute', 'Wazuh', 'Cisco Secure', 'OffSec', 'MITRE ATT&CK'].map(
							(brand) => <li>{brand}</li>,
						)
					}
				</ul>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	/* ---- Hero ---- */
	.hero {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding-top: 1rem;
	}

	.intro {
		align-items: center;
		text-align: center;
	}

	.status-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.9rem;
		border: 1px solid var(--accent-border);
		border-radius: var(--radius-sm);
		background: var(--accent-subtle);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text);
	}

	.dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999rem;
		background: var(--success);
		animation: statusPulse 2.4s ease-in-out infinite;
	}

	.headline {
		font-size: var(--text-4xl);
	}

	.tagline {
		max-width: 46ch;
		font-size: var(--text-md);
		line-height: 1.65;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.75rem;
		justify-content: center;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.7em 1.5em;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: var(--text-base);
		text-decoration: none;
		line-height: 1.1;
		transition:
			background-color var(--theme-transition),
			border-color var(--theme-transition),
			color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.btn.primary {
		color: var(--accent-text-over);
		background: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 70%, var(--text-strong));
		box-shadow: var(--shadow-sm);
	}

	.btn.primary:hover,
	.btn.primary:focus-visible {
		background: var(--accent-strong);
		color: var(--accent-text-over);
		transform: translateY(-1px);
		box-shadow: var(--shadow-md), var(--glow-strong);
	}

	.btn.secondary {
		color: var(--text-strong);
		background: var(--surface);
		border-color: var(--border-strong);
	}

	.btn.secondary:hover,
	.btn.secondary:focus-visible {
		border-color: var(--accent-border);
		color: var(--accent);
		transform: translateY(-1px);
		box-shadow: var(--glow-accent);
	}

	/* ---- Profile card: operator console panel ---- */
	.profile-card {
		position: relative;
		width: 100%;
		max-width: 26rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem 1.75rem 1.75rem;
		background: var(--surface);
		border: 1px solid var(--accent-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	/* Thin neon rule across the panel top */
	.profile-card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 2px;
		background: var(--neon-rule);
		opacity: 0.85;
	}

	.pc-hud {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.pc-online {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--text-muted);
	}

	.pc-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999rem;
		background: var(--success);
		animation: statusPulse 2.4s ease-in-out infinite;
	}

	.pc-head {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.pc-avatar {
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 999rem;
		font-family: var(--font-brand);
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--accent);
		background: var(--accent-subtle);
		border: 1px solid var(--accent-border);
		box-shadow: var(--glow-accent);
	}

	.pc-name {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.pc-name strong {
		font-family: var(--font-brand);
		font-size: var(--text-md);
		color: var(--text-strong);
	}

	.pc-name span {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	.pc-facts {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin: 0;
	}

	.pc-facts div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0.75rem;
		align-items: baseline;
	}

	.pc-facts dt {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
	}

	.pc-facts dd {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text);
	}

	.pc-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}

	.pc-link:hover {
		color: var(--accent-strong);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 5fr;
			align-items: center;
			gap: 4rem;
			padding-top: 2rem;
		}

		.intro {
			align-items: flex-start;
			text-align: left;
		}

		.headline {
			font-size: var(--text-5xl);
		}

		.tagline {
			font-size: var(--text-lg);
		}

		.roles,
		.cta-row {
			justify-content: flex-start;
		}

		.profile-card {
			justify-self: end;
			margin-inline: 0;
		}
	}

	/* ---- Sections ---- */
	.section {
		display: grid;
		gap: 2rem;
	}

	.section-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}

	.section-header h2 {
		font-size: var(--text-2xl);
	}

	.section-header p {
		color: var(--text-muted);
		max-width: 50ch;
	}

	.view-all {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		white-space: nowrap;
	}

	.view-all:hover {
		color: var(--accent-strong);
	}

	@media (min-width: 50em) {
		.section-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
		}

		.section-header h2 {
			font-size: var(--text-3xl);
		}
	}

	.blog-preview-list {
		display: grid;
		gap: 1.25rem;
	}

	@media (min-width: 50em) {
		.blog-preview-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}

	.brand-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 0;
		list-style: none;
	}

	.brand-row li {
		padding: 0.65rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 999rem;
		background: var(--surface);
		color: var(--text);
		font-weight: 500;
		font-size: var(--text-sm);
		transition:
			border-color var(--theme-transition),
			color var(--theme-transition);
	}

	.brand-row li:hover {
		border-color: var(--accent-border);
		color: var(--text-strong);
	}
</style>
