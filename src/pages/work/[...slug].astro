---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const published = entry.data.publishDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="stack gap-20">
		<article class="wrapper article-shell">
			<header class="article-header stack gap-4">
				<a class="back-link" href="/work/"><Icon icon="arrow-left" /> Work</a>
				<div class="eyebrow">
					<time datetime={entry.data.publishDate.toISOString()}>{published}</time>
					<span>Case study</span>
				</div>
				<h1>{entry.data.title}</h1>
				<p class="description">{entry.data.description}</p>
				{entry.data.tags.length > 0 && (
					<div class="tags" aria-label="Project tags">
						{entry.data.tags.map((tag) => <Pill>{tag}</Pill>)}
					</div>
				)}
			</header>

			{entry.data.img && (
				<img
					class="hero-image"
					src={entry.data.img}
					alt={entry.data.img_alt || ''}
					loading="eager"
					decoding="async"
				/>
			)}

			<div class="prose">
				<Content />
			</div>
		</article>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.article-shell {
		max-width: 58rem;
	}

	.article-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--accent-regular) 22%, transparent);
	}

	.back-link {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--accent-regular);
		text-decoration: none;
		transition: text-shadow var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus-visible {
		text-shadow: 0 0 12px color-mix(in srgb, var(--accent-regular) 70%, transparent);
	}

	.eyebrow {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.eyebrow span::before {
		content: '• ';
		color: var(--accent-regular);
	}

	h1 {
		max-width: 16ch;
		font-size: var(--text-3xl);
		text-transform: uppercase;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent-regular) 35%, transparent));
	}

	.description {
		max-width: 62ch;
		font-size: var(--text-lg);
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.hero-image {
		width: 100%;
		margin-block: 2rem;
		border: 1px solid color-mix(in srgb, var(--accent-regular) 30%, transparent);
		border-radius: 0.9rem;
		box-shadow: var(--shadow-md), 0 0 30px color-mix(in srgb, var(--accent-regular) 14%, transparent);
	}

	.prose {
		max-width: 72ch;
		margin: 2.5rem auto 0;
		font-size: var(--text-md);
		color: var(--gray-200);
	}

	.prose :global(* + *) {
		margin-top: 1.15rem;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2.25rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--gray-0);
	}

	.prose :global(h2) {
		font-size: var(--text-3xl);
		padding-bottom: 0.45rem;
		border-bottom: 1px solid color-mix(in srgb, var(--accent-regular) 25%, transparent);
	}

	.prose :global(h3) {
		font-size: var(--text-2xl);
	}

	.prose :global(p),
	.prose :global(li) {
		line-height: 1.75;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-inline-start: 1.5rem;
	}

	.prose :global(strong) {
		color: var(--gray-0);
	}

	.prose :global(img) {
		max-width: min(100%, 40rem);
		height: auto;
		border-radius: 0.9rem;
		box-shadow: var(--shadow-md), 0 0 30px color-mix(in srgb, var(--accent-regular) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent-regular) 30%, transparent);
	}

	.prose :global(blockquote) {
		padding: 1rem 1.25rem;
		border-inline-start: 0.25rem solid var(--accent-regular);
		border-radius: 0 0.5rem 0.5rem 0;
		background: color-mix(in srgb, var(--accent-regular) 8%, transparent);
		color: var(--gray-0);
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
	}

	.prose :global(code) {
		padding: 0.12em 0.4em;
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--accent-regular) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent-regular) 22%, transparent);
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.92em;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--accent-regular) 26%, transparent);
		border-radius: 0.7rem;
		background: rgba(4, 7, 16, 0.9);
		box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.5);
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
		border: 0;
		color: inherit;
		font-size: 0.85rem;
	}

	.prose :global(table) {
		display: block;
		width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.92rem;
	}

	.prose :global(th),
	.prose :global(td) {
		border: 1px solid color-mix(in srgb, var(--accent-regular) 20%, transparent);
		padding: 0.6rem 0.85rem;
		text-align: left;
	}

	.prose :global(th) {
		font-family: var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.78rem;
		color: var(--gray-0);
		background: color-mix(in srgb, var(--accent-regular) 14%, transparent);
	}

	.prose :global(tbody tr:nth-child(even) td) {
		background: rgba(255, 255, 255, 0.02);
	}

	.prose :global(hr) {
		height: 1px;
		border: 0;
		background: var(--gradient-accent);
		opacity: 0.5;
		margin: 2rem 0;
	}

	.prose :global(a) {
		color: var(--link-color);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--link-color) 40%, transparent);
		text-underline-offset: 0.2em;
		transition: text-shadow var(--theme-transition);
	}

	.prose :global(a:hover),
	.prose :global(a:focus) {
		text-shadow: 0 0 12px color-mix(in srgb, var(--link-color) 70%, transparent);
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-4xl);
		}
	}
</style>
