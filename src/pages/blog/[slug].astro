---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((entry) => !entry.data.draft);
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const published = entry.data.publishDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const updated = entry.data.updatedDate?.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={`${entry.data.title} | Tony Muzo`} description={entry.data.description}>
	<div class="stack gap-20">
		<article class="wrapper article-shell">
			<header class="article-header stack gap-4">
				<a class="back-link" href="/blog/"><Icon icon="arrow-left" /> Blog</a>
				<div class="eyebrow">
					<time datetime={entry.data.publishDate.toISOString()}>{published}</time>
					{updated && <span>Updated {updated}</span>}
				</div>
				<h1>{entry.data.title}</h1>
				<p class="description">{entry.data.description}</p>
				{entry.data.tags.length > 0 && (
					<div class="tags" aria-label="Article tags">
						{entry.data.tags.map((tag) => <Pill>{tag}</Pill>)}
					</div>
				)}
			</header>

			{entry.data.img && (
				<img class="hero-image" src={entry.data.img} alt={entry.data.img_alt || ''} loading="eager" decoding="async" />
			)}

			<div class="prose">
				<Content />
			</div>
		</article>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.article-shell {
		max-width: 58rem;
	}

	.article-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-brand);
		font-weight: 600;
		color: var(--gray-300);
		text-decoration: none;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: var(--accent-dark);
	}

	.eyebrow {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	.eyebrow span::before {
		content: '• ';
		color: var(--accent-regular);
	}

	h1 {
		max-width: 12ch;
		font-size: var(--text-4xl);
	}

	.description {
		max-width: 62ch;
		font-size: var(--text-lg);
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.hero-image {
		width: 100%;
		margin-block: 2rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.prose {
		max-width: 72ch;
		margin: 2.5rem auto 0;
		font-size: var(--text-md);
		color: var(--gray-200);
	}

	.prose :global(* + *) {
		margin-top: 1.15rem;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2.25rem;
		color: var(--gray-100);
	}

	.prose :global(h2) {
		font-size: var(--text-3xl);
	}

	.prose :global(h3) {
		font-size: var(--text-2xl);
	}

	.prose :global(p),
	.prose :global(li) {
		line-height: 1.75;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-inline-start: 1.5rem;
	}

	.prose :global(blockquote) {
		padding: 1rem 1.25rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		border-radius: 0.75rem;
		background: var(--gradient-subtle);
		color: var(--gray-100);
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		box-shadow: var(--shadow-sm);
	}

	.prose :global(code) {
		padding: 0.125rem 0.3rem;
		border-radius: 0.35rem;
		background: var(--gray-900);
		color: var(--gray-100);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.92em;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 1rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.9rem;
		background: var(--gray-900);
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
	}

	.prose :global(a) {
		text-underline-offset: 0.25em;
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-5xl);
		}
	}
</style>
