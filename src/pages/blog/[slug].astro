---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readingTime } from '../../utils/readingTime';

interface Props {
	entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((entry) => !entry.data.draft);
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const published = entry.data.publishDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
const updated = entry.data.updatedDate?.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
const minutes = readingTime(entry.body);
---

<BaseLayout title={`${entry.data.title} | Tony Muzo`} description={entry.data.description}>
	<div class="stack gap-20">
		<article class="wrapper article-shell">
			<header class="article-header stack gap-4">
				<a class="back-link" href="/blog/"><Icon icon="arrow-left" /> All articles</a>
				<div class="meta">
					<time datetime={entry.data.publishDate.toISOString()}>{published}</time>
					{updated && <span>Updated {updated}</span>}
					<span>{minutes} min read</span>
				</div>
				<h1>{entry.data.title}</h1>
				<p class="description">{entry.data.description}</p>
				{
					entry.data.tags.length > 0 && (
						<ul class="tags" aria-label="Article tags">
							{entry.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)
				}
			</header>

			{
				entry.data.img && (
					<img
						class="hero-image"
						src={entry.data.img}
						alt={entry.data.img_alt || ''}
						loading="eager"
						decoding="async"
					/>
				)
			}

			<div class="prose">
				<Content />
			</div>

			<footer class="article-footer">
				<div class="share" data-title={entry.data.title}>
					<span class="share-label">Share this article</span>
					<div class="share-actions">
						<a class="share-btn" data-share="linkedin" href="#" rel="noopener" target="_blank">
							<Icon icon="linkedin-logo" size="1.1em" /> LinkedIn
						</a>
						<a class="share-btn" data-share="x" href="#" rel="noopener" target="_blank">
							<Icon icon="twitter-logo" size="1.1em" /> X
						</a>
						<button class="share-btn" data-share="copy" type="button">
							<Icon icon="paper-plane-tilt" size="1.1em" /> <span class="copy-text">Copy link</span>
						</button>
					</div>
				</div>
				<div class="author">
					<span class="author-avatar" aria-hidden="true">TM</span>
					<div>
						<strong>Tony Muzo</strong>
						<p>
							Cybersecurity analyst focused on threat intelligence, incident response, and security
							automation. <a href="/about/">More about me</a>
						</p>
					</div>
				</div>
			</footer>
		</article>

		<ContactCTA />
	</div>
</BaseLayout>

<script>
	// Build share URLs from the live page URL so they work on any deployment.
	const share = document.querySelector<HTMLElement>('.share');
	if (share) {
		const url = encodeURIComponent(window.location.href);
		const title = encodeURIComponent(share.dataset.title ?? document.title);

		const linkedin = share.querySelector<HTMLAnchorElement>('[data-share="linkedin"]');
		if (linkedin) linkedin.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

		const x = share.querySelector<HTMLAnchorElement>('[data-share="x"]');
		if (x) x.href = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;

		const copy = share.querySelector<HTMLButtonElement>('[data-share="copy"]');
		copy?.addEventListener('click', async () => {
			await navigator.clipboard.writeText(window.location.href);
			const label = copy.querySelector('.copy-text');
			if (label) {
				label.textContent = 'Copied!';
				setTimeout(() => (label.textContent = 'Copy link'), 2000);
			}
		});
	}
</script>

<style>
	.article-shell {
		max-width: 46rem;
	}

	.article-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}

	.back-link {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: var(--accent-strong);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.65rem;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--text-muted);
	}

	.meta span::before {
		content: '·';
		margin-right: 0.65rem;
		color: var(--accent);
	}

	h1 {
		font-size: var(--text-3xl);
		line-height: 1.15;
	}

	.description {
		font-size: var(--text-lg);
		line-height: 1.6;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.2rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: 999rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-muted);
		background: var(--surface-2);
	}

	.hero-image {
		width: 100%;
		margin-block: 2rem 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}

	.prose {
		margin-top: 2.5rem;
	}

	/* ---- Article footer ---- */
	.article-footer {
		margin-top: 3rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.share-label {
		font-weight: 600;
		font-size: var(--text-sm);
		color: var(--text-strong);
	}

	.share-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.55rem;
		background: transparent;
		color: var(--text);
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition:
			border-color var(--theme-transition),
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.share-btn:hover,
	.share-btn:focus-visible {
		border-color: var(--accent-border);
		color: var(--accent);
		background: var(--accent-subtle);
	}

	.author {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.author-avatar {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 999rem;
		font-family: var(--font-brand);
		font-weight: 700;
		color: var(--accent);
		background: var(--accent-subtle);
		border: 1px solid var(--accent-border);
	}

	.author strong {
		font-family: var(--font-brand);
		color: var(--text-strong);
	}

	.author p {
		margin-top: 0.25rem;
		font-size: var(--text-sm);
		color: var(--text-muted);
		line-height: 1.6;
	}

	@media (min-width: 50em) {
		h1 {
			font-size: var(--text-4xl);
		}
	}
</style>
