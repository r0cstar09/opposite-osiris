---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch all blog posts and sort newest first
const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
    title="Blog | Tony Muzo"
    description="Insights and commentary on cybersecurity, threat intelligence, and defensive strategy."
>
    <div class="stack gap-20">
        <main class="wrapper stack gap-8">
            <Hero
                title="Blog"
                tagline="Analysis, critique, and commentary on cyber defence, operator capability, and strategic dysfunction."
                align="start"
            />

            <Grid variant="offset">
                {
                    posts.map((post) => (
                        <li>
                            <!-- Reuse your existing project preview logic by inlining markup -->
                            <a href={`/blog/${post.slug}/`}>
                                <h3>{post.data.title}</h3>
                                <p>{post.data.description}</p>
                            </a>
                        </li>
                    ))
                }
            </Grid>
        </main>

        <ContactCTA />
    </div>
</BaseLayout>