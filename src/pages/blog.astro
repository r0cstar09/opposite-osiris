---
import { getCollection } from 'astro:content';
import BlogPostPreview from '../components/BlogPostPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featured = posts[0];
const remaining = posts.slice(1);
---

<BaseLayout
	title="Blog | Tony Muzo"
	description="Cybersecurity writing, defensive engineering notes, and operator-focused commentary by Tony Muzo."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-10">
			<Hero
				eyebrow="// threat_intel_feed"
				title="Writing"
				tagline="Field notes on cybersecurity, threat intelligence, defensive automation, and the operational reality behind the dashboards."
				align="start"
			/>

			<section class="blog-shell" aria-label="Blog posts">
				{
					posts.length > 0 ? (
						<>
							{featured && <BlogPostPreview post={featured} featured />}
							{remaining.map((post) => (
								<BlogPostPreview post={post} />
							))}
						</>
					) : (
						<div class="empty-state">
							<h2>No articles published yet.</h2>
							<p>
								Add Markdown files to <code>src/content/blog/</code> to publish articles here.
							</p>
						</div>
					)
				}
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.blog-shell {
		display: grid;
		gap: 1.25rem;
	}

	.empty-state {
		padding: 2.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.empty-state h2 {
		font-size: var(--text-xl);
	}

	.empty-state p {
		margin-top: 0.75rem;
		color: var(--text-muted);
	}

	.empty-state code {
		font-family: var(--font-mono);
		font-size: 0.875em;
		color: var(--text-strong);
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 0.35rem;
		padding: 0.15em 0.4em;
	}

	@media (min-width: 50em) {
		.blog-shell {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}
</style>
