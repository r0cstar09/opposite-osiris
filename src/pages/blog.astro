---
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');
---

<h1>Blog</h1>

<ul>
  {posts
    .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
    .map(post => (
      <li>
        <a href={`/blog/${post.slug}/`}>
          {post.data.title}
        </a>
        <p>{post.data.description}</p>
      </li>
    ))
  }
</ul>