---
import CertBadge from '../components/CertBadge.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Tony Muzo" description="About cybersecurity professional Tony Muzo">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				eyebrow="// operator_profile"
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<div class="terminal" aria-hidden="true">
					<div class="term-bar">
						<span class="tb-dot red"></span>
						<span class="tb-dot amber"></span>
						<span class="tb-dot green"></span>
						<span class="tb-title">whoami.sh</span>
					</div>
					<pre class="term-body"><span class="tl" style="--i:0"><span class="c">$</span> whoami</span>
<span class="tl" style="--i:1"><span class="o">&gt; tony_muzo</span></span>
<span class="tl" style="--i:2"><span class="c">$</span> role --current</span>
<span class="tl" style="--i:3"><span class="o">&gt; Cybersecurity Analyst · Threat Intelligence</span></span>
<span class="tl" style="--i:4"><span class="c">$</span> experience --years</span>
<span class="tl" style="--i:5"><span class="o">&gt; 8+</span></span>
<span class="tl" style="--i:6"><span class="c">$</span> certs --list</span>
<span class="tl" style="--i:7"><span class="o">&gt; GSEC · GCIH · GPYC · GFACT</span></span>
<span class="tl" style="--i:8"><span class="c">$</span> location</span>
<span class="tl" style="--i:9"><span class="o">&gt; Toronto, CA</span></span>
<span class="tl" style="--i:10"><span class="c">$</span> status</span>
<span class="tl" style="--i:11"><span class="o ok">&gt; [OK] available_for_work</span><span class="cursor">▋</span></span></pre>
				</div>
			</Hero>

			<h2 class="section-title">Background</h2>
			<div class="content">
				<p>
					Cybersecurity analyst with 8+ years across threat intelligence, incident response, and
					security operations. I specialize in ransomware ecosystem analysis and MITRE ATT&CK
					mapping — turning attacker behavior into intelligence that SOC, IR, and leadership teams
					can act on. Previous roles include Cisco Security, Symantec, One Arrow Consulting, and
					the City of St. John’s.
				</p>
			</div>
			<h2 class="section-title">Education</h2>
			<div class="content">
				<p>
					Ongoing training through SANS Institute, AWS security pathways, and technical
					communication programs.
				</p>
			</div>
			<h2 class="section-title">Skills</h2>
			<div class="content">
				<ul>
					<li><strong>Threat Intelligence:</strong> Ransomware profiling, adversary TTP analysis, MITRE ATT&CK mapping.</li>
					<li><strong>Security Operations:</strong> Event monitoring, incident coordination, access control and endpoint behavior analysis.</li>
					<li><strong>Incident Response:</strong> Threat containment, documentation, multi-team collaboration.</li>
					<li><strong>Network Security:</strong> Firewalls, endpoint protection, IDS/IPS, WAF technologies.</li>
					<li><strong>Governance & Compliance:</strong> ISO 27001, NIST frameworks, audit support.</li>
					<li><strong>Communication:</strong> Technical & executive reporting, security awareness writing and instruction.</li>
				</ul>
			</div>
			<h2 class="section-title">Certifications</h2>
			<div class="content">
				<ul class="cert-list">
					<li>
						<a href="https://www.credly.com/earner/earned/badge/6c995198-44cd-489b-afbc-fe0f808e6f19" target="_blank" rel="noopener">
							<CertBadge code="GFACT" top="GIAC FOUNDATIONAL" bottom="TECHNOLOGIES" />
							<span class="cert-name">
								<strong>GFACT</strong>
								<span>GIAC Foundational Cybersecurity Technologies</span>
							</span>
						</a>
					</li>
					<li>
						<a href="https://www.credly.com/earner/earned/badge/19d96369-714b-4982-8317-8665845f6678" target="_blank" rel="noopener">
							<CertBadge code="GSEC" top="GIAC SECURITY" bottom="ESSENTIALS" />
							<span class="cert-name">
								<strong>GSEC</strong>
								<span>GIAC Security Essentials Certification</span>
							</span>
						</a>
					</li>
					<li>
						<a href="https://www.credly.com/earner/earned/badge/628f4b85-445f-45d2-8898-c0000c547416" target="_blank" rel="noopener">
							<CertBadge code="GCIH" top="GIAC INCIDENT" bottom="HANDLER" />
							<span class="cert-name">
								<strong>GCIH</strong>
								<span>GIAC Certified Incident Handler</span>
							</span>
						</a>
					</li>
					<li>
						<a href="https://www.credly.com/earner/earned/badge/50af4086-4502-4519-a94b-b7cbfc11fef4" target="_blank" rel="noopener">
							<CertBadge code="GPYC" top="GIAC PYTHON" bottom="CODER" />
							<span class="cert-name">
								<strong>GPYC</strong>
								<span>GIAC Python Coder</span>
							</span>
						</a>
					</li>
					<li>
						<a href="https://www.credly.com/earner/earned/badge/57be01ae-b3cc-4644-88be-98be0bd47733" target="_blank" rel="noopener">
							<CertBadge code="AWS" top="SECURE BUILDER" bottom="SEC480" />
							<span class="cert-name">
								<strong>AWS Secure Builder</strong>
								<span>SEC480</span>
							</span>
						</a>
					</li>
					<li>
						<a href="https://www.credly.com/earner/earned/badge/a119d428-e5be-4ec9-9d95-ef1efa92538c" target="_blank" rel="noopener">
							<CertBadge code="CBROPS" top="CISCO CYBEROPS" bottom="FUNDAMENTALS" />
							<span class="cert-name">
								<strong>Cisco CyberOps</strong>
								<span>Understanding Cisco Cybersecurity Operations Fundamentals</span>
							</span>
						</a>
					</li>
				</ul>
			</div>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	/* Terminal card — intentionally dark in both themes. */
	.terminal {
		margin-top: 1.75rem;
		max-width: 34rem;
		width: 100%;
		margin-inline: auto;
		border: 1px solid #26324b;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: #0b1220;
		box-shadow: var(--shadow-md);
		text-align: left;
	}

	.term-bar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0.9rem;
		background: #111a2c;
		border-bottom: 1px solid #26324b;
	}

	.tb-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999rem;
		background: #3a4a68;
	}

	.tb-dot.red {
		background: #b4485c;
	}
	.tb-dot.amber {
		background: #b8934a;
	}
	.tb-dot.green {
		background: #3d9e78;
	}

	.tb-title {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #6b7a97;
	}

	.term-body {
		margin: 0;
		padding: 1.25rem 1.4rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		line-height: 1.9;
		color: #c4cfe1;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.term-body .c {
		color: #4cc3f7;
	}
	.term-body .o {
		color: #e8eef8;
	}
	.term-body .o.ok {
		color: #34d399;
	}

	/* Console output prints in line by line. */
	.term-body .tl {
		opacity: 0;
		animation: lineIn 0.01s steps(1) forwards;
		animation-delay: calc(var(--i) * 0.26s + 0.35s);
	}

	.cursor {
		color: #4cc3f7;
		margin-left: 0.15rem;
		animation: blink 1.1s steps(2) infinite;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--text);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-lg);
		color: var(--text-strong);
	}

	.content {
		grid-column: 2 / 4;
		color: var(--text);
		font-size: var(--text-base);
		line-height: 1.75;
	}

	.content p + p {
		margin-top: 1rem;
	}

	.content ul {
		padding-inline-start: 1.25rem;
	}

	.content li + li {
		margin-top: 0.5rem;
	}

	.content :global(strong) {
		color: var(--text-strong);
		font-weight: 600;
	}

	.content :global(a) {
		color: var(--link-color);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--link-color) 40%, transparent);
		text-underline-offset: 0.2em;
		transition: color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		color: var(--accent-strong);
		text-decoration-color: currentColor;
	}

	.cert-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.cert-list li + li {
		margin-top: 0;
	}

	.cert-list a {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--border);
		border-left: 2px solid var(--accent-border);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text-strong);
		font-weight: 500;
		font-size: 0.9375rem;
		text-decoration: none;
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			color var(--theme-transition),
			transform var(--theme-transition);
	}

	.cert-list a:hover,
	.cert-list a:focus {
		border-color: var(--accent-border);
		border-left-color: var(--accent);
		color: var(--accent);
		transform: translateX(3px);
		box-shadow: var(--shadow-sm), var(--glow-accent);
	}

	.cert-name {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.cert-name strong {
		font-family: var(--font-brand);
		font-weight: 600;
	}

	.cert-name > span {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
			gap: 2.5rem 3rem;
		}

		.about > :global(:first-child) {
			grid-column: 1 / -1;
		}

		.section-title {
			grid-column: 1 / 2;
			justify-self: end;
			text-align: right;
			font-size: var(--text-lg);
			position: relative;
			padding-top: 0.15rem;
		}

		.content {
			grid-column: 2 / 3;
		}
	}
</style>
