---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a class:list={[variant]} href={href}><slot /></a>

<style>
	a {
		display: inline-flex;
		place-content: center;
		align-items: center;
		gap: 0.6em;
		text-align: center;
		padding: 0.75em 1.6em;
		text-decoration: none;
		line-height: 1.1;
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: var(--text-base);
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		transition:
			background-color var(--theme-transition),
			border-color var(--theme-transition),
			color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	a.primary {
		color: var(--accent-text-over);
		background: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 70%, var(--text-strong));
		box-shadow: var(--shadow-sm);
	}

	a.primary:hover,
	a.primary:focus-visible {
		background: var(--accent-strong);
		color: var(--accent-text-over);
		transform: translateY(-1px);
		box-shadow: var(--shadow-md), var(--glow-strong);
	}

	a.secondary {
		color: var(--text-strong);
		background: var(--surface);
		border-color: var(--border-strong);
	}

	a.secondary:hover,
	a.secondary:focus-visible {
		border-color: var(--accent-border);
		color: var(--accent);
		transform: translateY(-1px);
		box-shadow: var(--glow-accent);
	}
</style>
