---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<div class="copy stack gap-4">
		<span class="mono-label">// establish_connection</span>
		<h2>Interested in working together?</h2>
		<p class="subtitle">
			Available for security engineering, threat intelligence reporting, and automation tooling projects.
		</p>
	</div>
	<CallToAction href="mailto:tony@tonymuzo.dev">
		Contact Tony
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	aside {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		border-top: 1px solid color-mix(in srgb, var(--accent-regular) 30%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--accent-regular) 30%, transparent);
		padding: 5rem 1.5rem;
		background: var(--gray-999_40);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
	}

	aside::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			40rem 20rem at 50% 120%,
			color-mix(in srgb, var(--accent-regular) 18%, transparent),
			transparent 70%
		);
	}

	.copy {
		position: relative;
		align-items: center;
		text-align: center;
	}

	h2 {
		font-size: var(--text-xl);
		max-width: 18ch;
		text-transform: uppercase;
	}

	.subtitle {
		font-size: var(--text-md);
		max-width: 44ch;
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		aside {
			padding: 7rem 5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 3rem;
		}

		.copy {
			align-items: flex-start;
			text-align: left;
		}

		h2 {
			font-size: var(--text-3xl);
		}
	}
</style>
