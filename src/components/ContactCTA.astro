---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside class="wrapper">
	<div class="panel">
		<div class="copy stack gap-4">
			<p class="mono-label">// establish_connection</p>
			<h2>Interested in working together?</h2>
			<p class="subtitle">
				Available for security engineering, threat intelligence reporting, and automation tooling
				projects.
			</p>
		</div>
		<CallToAction href="mailto:tony@tonymuzo.dev">
			Contact Tony
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</CallToAction>
	</div>
</aside>

<style>
	aside {
		padding-block: 1rem 4rem;
	}

	.panel {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		text-align: center;
		padding: 3rem 1.5rem;
		border: 1px solid var(--accent-border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
	}

	/* Thin neon rule across the panel top */
	.panel::after {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 2px;
		background: var(--neon-rule);
		opacity: 0.85;
	}

	.panel::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			32rem 14rem at 50% -20%,
			var(--accent-subtle),
			transparent 70%
		);
	}

	.copy {
		position: relative;
		align-items: center;
	}

	h2 {
		font-size: var(--text-xl);
		max-width: 24ch;
	}

	.subtitle {
		font-size: var(--text-base);
		max-width: 50ch;
		color: var(--text-muted);
	}

	@media (min-width: 50em) {
		.panel {
			padding: 4rem 4.5rem;
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
			gap: 3rem;
		}

		.copy {
			align-items: flex-start;
		}

		h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
