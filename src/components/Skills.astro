---
import Icon from './Icon.astro';
---

<section class="skills">
	<div class="skill glow-card" data-reveal>
		<span class="icon-chip cyan"><Icon icon="book-open" size="1.4rem" /></span>
		<h2>Threat Intelligence</h2>
		<p>
			Profiling ransomware groups, mapping adversary TTPs to MITRE ATT&CK, and producing
			intelligence that drives defensive engineering.
		</p>
	</div>
	<div class="skill glow-card" data-reveal>
		<span class="icon-chip violet"><Icon icon="code" size="1.4rem" /></span>
		<h2>Security Automation</h2>
		<p>
			Building tooling and pipelines that eliminate manual workload, accelerate investigations, and
			strengthen SOC efficiency.
		</p>
	</div>
	<div class="skill glow-card" data-reveal>
		<span class="icon-chip red"><Icon icon="shield" size="1.4rem" /></span>
		<h2>Detection & Incident Response</h2>
		<p>
			Developing detections, coordinating incident response workflows, and translating complex
			attacker behavior into actionable defense.
		</p>
	</div>
</section>

<style>
	.skills {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.skill {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	/* Thin accent rule along the top of each panel */
	.skill::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 2px;
		background: var(--chip-color, var(--accent));
		opacity: 0.55;
		transition: opacity var(--theme-transition);
	}

	.skill:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--chip-color, var(--accent)) 35%, transparent);
		box-shadow: var(--shadow-md);
	}

	.skill:hover::before {
		opacity: 1;
	}

	.icon-chip {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-sm);
		color: var(--chip-color, var(--accent));
		background: var(--chip-bg, var(--accent-subtle));
		border: 1px solid var(--chip-border, var(--accent-border));
	}

	.skill:has(.icon-chip.cyan) {
		--chip-color: var(--accent);
		--chip-bg: var(--accent-subtle);
		--chip-border: var(--accent-border);
	}

	.skill:has(.icon-chip.violet) {
		--chip-color: var(--violet);
		--chip-bg: var(--violet-subtle);
		--chip-border: var(--violet-border);
	}

	.skill:has(.icon-chip.red) {
		--chip-color: var(--alert);
		--chip-bg: var(--alert-subtle);
		--chip-border: var(--alert-border);
	}

	.skill h2 {
		font-size: var(--text-lg);
	}

	.skill p {
		color: var(--text-muted);
		font-size: 0.9375rem;
		line-height: 1.65;
	}

	@media (min-width: 50em) {
		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}

		.skill {
			padding: 2rem;
		}
	}
</style>
