---
/**
 * Cyberpunk take on the classic GIAC circular badge: neon ring,
 * wireframe globe, cert code front and center, curved micro-labels.
 */
interface Props {
	code: string;
	top?: string;
	bottom?: string;
}

const { code, top = 'GIAC', bottom = 'CERTIFIED' } = Astro.props;
const uid = 'cb' + Math.random().toString(36).slice(2, 8);
const codeSize = code.length > 4 ? 15 : code.length > 3 ? 18 : 22;
---

<svg class="cert-badge" viewBox="0 0 100 100" aria-hidden="true">
	<defs>
		<linearGradient id={`${uid}-ring`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="var(--gradient-stop-1)"></stop>
			<stop offset="1" stop-color="var(--gradient-stop-3)"></stop>
		</linearGradient>
		<path id={`${uid}-arcTop`} d="M 14 50 A 36 36 0 0 1 86 50" fill="none"></path>
		<path id={`${uid}-arcBot`} d="M 16.5 50 A 33.5 33.5 0 0 0 83.5 50" fill="none"></path>
	</defs>

	<!-- Outer neon ring -->
	<circle cx="50" cy="50" r="47.5" fill="var(--surface-2)" stroke={`url(#${uid}-ring)`} stroke-width="2.2"></circle>
	<!-- Inner band -->
	<circle cx="50" cy="50" r="37" fill="var(--surface)" stroke="var(--border-strong)" stroke-width="0.8"></circle>

	<!-- Wireframe globe -->
	<g class="globe" stroke="var(--gradient-stop-2)" stroke-width="1" fill="none" opacity="0.7">
		<circle cx="50" cy="50" r="25"></circle>
		<ellipse cx="50" cy="50" rx="11" ry="25"></ellipse>
		<path d="M 29.5 40 Q 50 33.5 70.5 40"></path>
		<path d="M 25 50 L 75 50"></path>
		<path d="M 29.5 60 Q 50 66.5 70.5 60"></path>
	</g>

	<!-- Cert code -->
	<text
		class="code"
		x="50"
		y="50"
		text-anchor="middle"
		dominant-baseline="central"
		font-size={codeSize}
		fill={`url(#${uid}-ring)`}>{code}</text
	>

	<!-- Curved micro-labels on the ring -->
	<text class="ring-label" font-size="6.4">
		<textPath href={`#${uid}-arcTop`} startOffset="50%" text-anchor="middle">{top}</textPath>
	</text>
	<text class="ring-label" font-size="6.4">
		<textPath href={`#${uid}-arcBot`} startOffset="50%" text-anchor="middle">{bottom}</textPath>
	</text>
</svg>

<style>
	.cert-badge {
		width: var(--badge-size, 4.25rem);
		height: var(--badge-size, 4.25rem);
		flex-shrink: 0;
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 25%, transparent));
	}

	.globe {
		transform-origin: 50px 50px;
	}

	:global(a:hover) .globe,
	:global(a:focus-visible) .globe {
		animation: spin 9s linear infinite;
	}

	.code {
		font-family: var(--font-brand);
		font-weight: 700;
		letter-spacing: 0.04em;
		paint-order: stroke;
		stroke: var(--surface);
		stroke-width: 2.5px;
	}

	.ring-label {
		font-family: var(--font-mono);
		font-weight: 500;
		letter-spacing: 0.22em;
		fill: var(--text-muted);
		text-transform: uppercase;
	}
</style>
