---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}`}>
	<div class="media">
		<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
	</div>
	<div class="body">
		<h3 class="title">{data.title}</h3>
		<p class="description">{data.description}</p>
		{
			data.tags.length > 0 && (
				<ul class="tags" aria-label="Project tags">
					{data.tags.slice(0, 3).map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)
		}
		<span class="read-more">View case study <span class="arrow">→</span></span>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition:
			transform var(--theme-transition),
			box-shadow var(--theme-transition),
			border-color var(--theme-transition);
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-4px);
		border-color: var(--accent-border);
		box-shadow: var(--shadow-md), var(--glow-accent);
	}

	.media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface-2);
		border-bottom: 1px solid var(--border);
	}

	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.card:hover .media img,
	.card:focus-visible .media img {
		transform: scale(1.04);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.4rem 1.5rem 1.5rem;
		flex: 1;
	}

	.title {
		font-size: var(--text-lg);
		color: var(--text-strong);
	}

	.description {
		color: var(--text-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		margin-top: 0.25rem;
		list-style: none;
	}

	.tags li {
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--text-muted);
		background: var(--surface-2);
	}

	.read-more {
		margin-top: auto;
		padding-top: 0.75rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.arrow {
		transition: transform var(--theme-transition);
	}

	.card:hover .arrow,
	.card:focus-visible .arrow {
		transform: translateX(4px);
	}
</style>
