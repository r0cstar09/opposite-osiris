---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}`}>
	<span class="frame"></span>
	<span class="title">{data.title}</span>
	<span class="cta">Open<span class="arrow">→</span></span>
	<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
</a>

<style>
	.card {
		position: relative;
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid color-mix(in srgb, var(--accent-regular) 22%, transparent);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-md);
		font-weight: 600;
		isolation: isolate;
		transition:
			transform var(--theme-transition),
			box-shadow var(--theme-transition),
			border-color var(--theme-transition);
	}

	/* Circuit-grid fallback shown behind the cover image (visible when a
	   project has no preview image yet). */
	.card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image:
			linear-gradient(var(--grid-color) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
		background-size:
			28px 28px,
			28px 28px;
		opacity: 0.6;
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-6px);
		border-color: var(--accent-regular);
		box-shadow: var(--shadow-md), 0 0 34px color-mix(in srgb, var(--accent-regular) 30%, transparent);
	}

	/* HUD corner brackets */
	.frame {
		position: absolute;
		inset: 0.6rem;
		z-index: 2;
		pointer-events: none;
		border: 1px solid transparent;
		border-radius: 0.4rem;
		background:
			linear-gradient(var(--accent-regular), var(--accent-regular)) top left / 1.25rem 2px no-repeat,
			linear-gradient(var(--accent-regular), var(--accent-regular)) top left / 2px 1.25rem no-repeat,
			linear-gradient(var(--accent-regular), var(--accent-regular)) bottom right / 1.25rem 2px no-repeat,
			linear-gradient(var(--accent-regular), var(--accent-regular)) bottom right / 2px 1.25rem no-repeat;
		opacity: 0.55;
		transition: opacity var(--theme-transition);
	}

	.card:hover .frame {
		opacity: 1;
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 3;
		align-self: start;
		margin: 0.75rem;
		padding: 0.45rem 0.9rem;
		background: rgba(5, 7, 15, 0.82);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: var(--gray-0);
		border: 1px solid color-mix(in srgb, var(--accent-regular) 45%, transparent);
		border-radius: 0.4rem;
		font-size: var(--text-base);
		letter-spacing: 0.02em;
	}

	.cta {
		grid-area: 2 / 2 / 3 / 3;
		z-index: 3;
		align-self: end;
		justify-self: end;
		margin: 0.75rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.8rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--accent-text-over);
		background: var(--accent-regular);
		border-radius: 0.3rem;
		box-shadow: var(--glow-cyan);
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity var(--theme-transition),
			transform var(--theme-transition);
	}

	.card:hover .cta,
	.card:focus-visible .cta {
		opacity: 1;
		transform: translateY(0);
	}

	.arrow {
		font-family: var(--font-brand);
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.85) contrast(1.05) brightness(0.82);
		transition:
			filter var(--theme-transition),
			transform 0.5s ease;
	}

	.card:hover img,
	.card:focus-visible img {
		filter: saturate(1.15) contrast(1.05) brightness(0.95);
		transform: scale(1.05);
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.25rem;
		}

		.title {
			font-size: var(--text-md);
			border-radius: 0.6rem;
		}
	}
</style>
