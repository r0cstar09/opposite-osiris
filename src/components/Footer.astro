---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="group">
		<p>Designed & developed in Toronto.</p>
		<p>&copy; {currentYear} Tony Muzo</p>
	</div>
	<p class="socials">
		<a href="https://github.com/r0cstar09">GitHub</a>
		<a href="https://www.linkedin.com/in/anthony-muzonzini-20702/">LinkedIn</a>
		<a href="mailto:tony@tonymuzo.dev">Email</a>
	</p>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: auto;
		padding: 2.5rem 2rem;
		text-align: center;
		color: var(--text-muted);
		font-size: var(--text-sm);
		border-top: 1px solid var(--border);
	}

	footer a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		color: var(--accent);
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			justify-content: space-between;
			padding: 2.5rem 5rem;
		}

		.group {
			flex-direction: row;
			gap: 1.5rem;
			flex-wrap: wrap;
		}

		.socials {
			justify-content: flex-end;
		}
	}
</style>
