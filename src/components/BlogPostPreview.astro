---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../utils/readingTime';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const date = post.data.publishDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
const minutes = readingTime(post.body);
---

<a class:list={['blog-card', 'glow-card', { featured }]} href={`/blog/${post.id}/`}>
	{
		post.data.img && (
			<div class="media">
				<img src={post.data.img} alt={post.data.img_alt || ''} loading="lazy" decoding="async" />
			</div>
		)
	}
	<div class="body">
		<div class="meta">
			<time datetime={post.data.publishDate.toISOString()}>{date}</time>
			<span>{minutes} min read</span>
		</div>
		<h2>{post.data.title}</h2>
		<p>{post.data.description}</p>
		{
			post.data.tags && post.data.tags.length > 0 && (
				<ul class="tags" aria-label="Post tags">
					{post.data.tags.slice(0, 3).map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)
		}
		<span class="read-more">Read article <span class="arrow">→</span></span>
	</div>
</a>

<style>
	.blog-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		overflow: hidden;
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.blog-card:hover,
	.blog-card:focus-visible {
		border-color: var(--accent-border);
		box-shadow: var(--shadow-md), var(--glow-accent);
		transform: translateY(-4px);
	}

	/* Featured intel item gets the thin neon rule */
	.blog-card.featured {
		border-color: var(--accent-border);
	}

	.blog-card.featured::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 2px;
		background: var(--neon-rule);
		background-size: 220% 100%;
		opacity: 0.85;
		z-index: 1;
		animation: neonShift 6s ease-in-out infinite alternate;
	}

	.media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface-2);
		border-bottom: 1px solid var(--border);
	}

	.media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.blog-card:hover .media img,
	.blog-card:focus-visible .media img {
		transform: scale(1.04);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.4rem 1.5rem 1.5rem;
		flex: 1;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.meta span::before {
		content: '·';
		margin-right: 0.5rem;
		color: var(--accent);
	}

	h2 {
		font-size: var(--text-lg);
		line-height: 1.3;
		color: var(--text-strong);
	}

	p {
		color: var(--text-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		margin-top: 0.25rem;
		list-style: none;
	}

	.tags li {
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--text-muted);
		background: var(--surface-2);
	}

	.read-more {
		margin-top: auto;
		padding-top: 0.75rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.arrow {
		transition: transform var(--theme-transition);
	}

	.blog-card:hover .arrow,
	.blog-card:focus-visible .arrow {
		transform: translateX(4px);
	}

	@media (min-width: 50em) {
		.blog-card.featured {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}

		.blog-card.featured .media {
			order: 2;
			aspect-ratio: auto;
			height: 100%;
			border-bottom: 0;
			border-left: 1px solid var(--border);
		}

		.blog-card.featured .body {
			order: 1;
			padding: 2.25rem 2.5rem;
			justify-content: center;
		}

		.blog-card.featured h2 {
			font-size: var(--text-2xl);
		}

		.blog-card.featured p {
			font-size: var(--text-base);
			-webkit-line-clamp: 4;
		}
	}
</style>
