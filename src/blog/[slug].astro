---
import { getCollection, getEntryBySlug } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
const { Content, data } = Astro.props;
---

<article>
  <h1>{data.title}</h1>
  <p>{data.date}</p>
  <Content />
</article>